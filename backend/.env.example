# ============================================================
# Unmask Backend — Variables d'environnement
# Copier en .env et renseigner les valeurs
# ============================================================

# --- Clés API ---
# Anthropic — réputation presse (Claude + web_search) : c'est le SEUL axe noté.
# Sans elle, le score retombe au neutre (50). Recommandée en priorité.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# YouTube Data API v3 : https://console.cloud.google.com (cohérence d'engagement — descriptif)
YOUTUBE_API_KEY=

# Serper.dev — recherche Google (OSINT + présence sociale)
# Inscription gratuite : https://serper.dev (2500 req/mois)
SERPER_API_KEY=

# Alternative à Serper : Google Custom Search API
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=

# Note : SIREN (identité légale) et AMF fonctionnent sans clé (APIs data.gouv publiques).

# --- Déploiement ---
# CORS : liste CSV des origines front autorisées.
# Dev : laisser "*" (ou ne pas définir).
# Prod : remplacer par l'URL exacte du front, ex.
# ALLOWED_ORIGINS=https://unmask.vercel.app
ALLOWED_ORIGINS=*

# Cache liste noire AMF (secondes). 21600 = 6h.
# AMF_CACHE_TTL_SECONDS=21600
